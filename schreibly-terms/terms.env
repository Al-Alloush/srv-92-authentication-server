# Configuration for the Schreibly Keycloak terms-acceptance gate.
#
# The version strings live HERE, not in code or in a template, so bumping a
# published document is a config change. They are the `updated:` date of the
# published legal document, normalised to ISO -- the document date IS the version.
#
#   https://schreibly.com/legal/terms    "Last updated: August 2026"     -> 2026-08
#   https://schreibly.com/legal/privacy  "Last updated: 29 August 2026"  -> 2026-08-29
#
# NOTE: the Terms document's `updated:` frontmatter carries no day, only a month,
# so the terms version can only be month-precise. Two Terms revisions published in
# the same month would be indistinguishable in the acceptance record. Fix belongs
# on the website side: give Content/legal/<lang>/terms.md a full `updated:` date.
#
# After changing either version, run ./check-versions.sh to confirm it matches
# what the live site actually serves, then follow the re-acceptance procedure in
# README.md ("Policy updates").

TERMS_VERSION=2026-08
PRIVACY_VERSION=2026-08-29

TERMS_URL=https://schreibly.com/legal/terms
PRIVACY_URL=https://schreibly.com/legal/privacy

# Realms this gate governs. Dev first, always.
REALMS=schreibly-dev,schreibly

# Locales the gate copy exists in. The stamper records the language the text was
# actually shown in; anything outside this set is recorded as DEFAULT_LOCALE.
SUPPORTED_LOCALES=en,de,ar
DEFAULT_LOCALE=en

# Abandoned-registration sweep (README "The sweep").
# 7 days, not 7 minutes: someone who closed the tab to go and read the policy
# properly must be able to come back and finish.
SWEEP_AFTER_DAYS=7

# The sweep DELETES accounts. It stays in dry-run until this is set to 1.
# Read a dry run first: ./schreibly_terms.py sweep --realm schreibly-dev
# Armed 2026-08-29 after a dry run on both realms returned no candidates.
# Set back to 0 to disarm; the daily job then only reports.
SWEEP_APPLY=1

# Keycloak admin API. Credentials are read from the running container's
# environment (see kc.py) -- do not put a password in this file.
KC_URL=http://127.0.0.1:8090

# Policy-change notification email (README "Policy updates", step 2).
# Keycloak's own SMTP for both realms is SendGrid as auth@schreibly.com. This
# tool cannot read Keycloak's stored SMTP password (the admin API masks it), so
# `notify` only sends once an operator puts an API key in the file below.
# Without it, `notify` renders the messages to disk for review and sends nothing.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=465
SMTP_USER=apikey
SMTP_FROM=auth@schreibly.com
SMTP_FROM_NAME=Schreibly
SMTP_PASSWORD_FILE=/srv/keycloak/schreibly-terms/smtp-password
